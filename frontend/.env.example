# Copia este archivo a .env.local y rellena los valores. No subas .env.local.

# --- Next.js (.env.local / Vercel) ---

# URL del despliegue de Convex (la escribe `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Opcional: claves de IA por defecto para desarrollo. Los usuarios usan la suya
# (BYOK, guardada en localStorage). No pongas claves de producción aquí: las
# variables NEXT_PUBLIC_* se incluyen en el bundle del navegador.
# NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_GROQ_API_KEY=

# Demo de un clic (opcional). Sin NEXT_PUBLIC_DEMO_EMAIL no se muestra el botón;
# sin DEMO_EMAIL o DEMO_PASSWORD, /api/demo-login responde 404.
# Crea antes ese usuario en Supabase Auth.
# NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=solo-servidor

# --- Convex (se configuran con `npx convex env set NOMBRE valor`, no en .env.local) ---

# Misma URL de Supabase que arriba; auth.config.ts la usa para verificar el JWT (JWKS)
# SUPABASE_URL=https://your-project.supabase.co

# Reinicio diario de la demo. Si falta DEMO_TOKEN_IDENTIFIER, el cron no hace nada.
# Formato: <SUPABASE_URL>/auth/v1|<id del usuario demo en Supabase>
# DEMO_TOKEN_IDENTIFIER=https://your-project.supabase.co/auth/v1|uuid-del-usuario-demo
# DEMO_EMAIL=demo@example.com
